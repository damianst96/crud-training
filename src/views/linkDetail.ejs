<!DOCTYPE html>
<html lang="en">
<head>
    <%-include('./partials/head.ejs')%>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.min.js" integrity="sha384-RuyvpeZCxMJCqVUGFI0Do1mQrods/hhxYlcVfGPOfQtPJh0JCw12tUAZ/Mv10S7D" crossorigin="anonymous"></script>
    <title>Automovilismo Web</title>
</head>

<body>
    <%-include('./partials/header.ejs')%>

    
        <% if (link) { %>
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <a class="card-title" href="<%= link.url %>"><%= link.title.toUpperCase() %></a>
                    <p class="card-text"><%= link.description %></p>
                    <a class="btn btn-secondary" href="#" role="button">Editar</a>
                    <a class="btn btn-danger" href="#" role="button">Borrar</a>
                </div>
            </div>
        <% } else { %>
            <p class="title">No hay links para mostrar</p>
        <% } %>
    

</body>
</html>